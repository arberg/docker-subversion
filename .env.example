# Published image used by the existing isolated deployment.
SUBVERSION_IMAGE=arberg/subversion:latest-isolated

# Host port for the svn:// service.
SVN_PORT=3690

# Existing persistent repository and SASL configuration locations on Unraid.
SVN_DATA_PATH=/mnt/disk1/svn
CONFIG_DATA_PATH=/mnt/user/docker/subversion

# Keep this /24 unique among Docker networks on the host. The companion
# install-network-isolation.sh script uses this subnet for its firewall rules.
NETWORK_ISOLATED_NAME=subversion_isolated
NETWORK_ISOLATED_SUBNET=172.16.1.0/24
